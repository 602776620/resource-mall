# 复制为 .env 并填入真实值（.env 不入库，06 号）
# 生成随机值：python -c "import secrets;print(secrets.token_hex(16))"
DB_PASSWORD=<token_hex(16)>
REDIS_PASSWORD=<token_hex(16)>
DB_DSN=postgresql+psycopg://mall:changeme@127.0.0.1:5432/mall
REDIS_DSN=redis://:changeme@127.0.0.1:16379/0
JWT_SECRET=<token_hex(32)>
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
SECRET_FILE=<token_hex(32)>
UPLOAD_ROOT=uploads
DOWNLOAD_ROOT=downloads
MAX_RESOURCE_MB=2048
CORS_ORIGINS=http://127.0.0.1:5173
ORDER_EXPIRE_MINUTES=30
DOWNLOAD_QUOTA=50
DOWNLOAD_WINDOW_DAYS=7
APP_ENV=dev
